# Application Config
APP_NAME="ugetjob-backend"
ENVIRONMENT="production"
PORT=8000

# PostgreSQL / Supabase Database Connection
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:your-supabase-password@db.xxxx.supabase.co:5432/postgres"

# Supabase Credentials & Storage
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon_key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role_key"

# Storage Bucket Names
CANDIDATE_RESUMES_BUCKET="candidate-resumes"
COMPANY_DOCUMENTS_BUCKET="company-documents"
JOB_ATTACHMENTS_BUCKET="job-attachments"

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://ugetjob.com,https://www.ugetjob.com"

# Admin Secret / JWT
SECRET_KEY="super-secret-jwt-key-replace-in-production"
