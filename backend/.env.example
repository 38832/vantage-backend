# Application Config
APP_NAME="ugetjob-backend"
ENVIRONMENT="development"
PORT=8000

# Supabase PostgreSQL pooler connection
# Use either the Session pooler (5432) or Transaction pooler (6543) URL from Supabase.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql+asyncpg://postgres.PROJECT_REF:DATABASE_PASSWORD@POOLER_HOST:6543/postgres"

# Supabase project settings
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Storage bucket names
CANDIDATE_RESUMES_BUCKET="candidate-resumes"
COMPANY_DOCUMENTS_BUCKET="company-document"
JOB_ATTACHMENTS_BUCKET="job-attachments"

# Comma-separated frontend origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://ugetjob.com,https://www.ugetjob.com"

# Replace this with a securely generated random value in production.
SECRET_KEY="replace-with-a-random-secret"

# Dynamic Terminal Logging Toggle (true = verbose query, payload, sorting & mutation logs; false = quiet)
ENABLE_DETAILED_LOGS="true"
